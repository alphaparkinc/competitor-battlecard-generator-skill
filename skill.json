{
  "name": "competitor-battlecard-generator-skill",
  "version": "1.0.0",
  "description": "Generate sales battle cards by comparing competitor pricing, features, and ads to map sales counter-objections.",
  "author": "alphaparkinc",
  "category": "sales",
  "tags": [
    "competitor-intelligence",
    "battlecards",
    "sales-enablement",
    "objections",
    "marketing"
  ],
  "inputs": {
    "competitor_name": {
      "type": "string",
      "description": "Name of competitor brand."
    },
    "competitor_pricing": {
      "type": "number",
      "description": "Competitor product price in USD."
    },
    "our_pricing": {
      "type": "number",
      "description": "Our product price in USD."
    },
    "competitor_advantages": {
      "type": "array",
      "description": "Features competitor highlights: [string]."
    }
  },
  "outputs": {
    "battlecard": {
      "type": "object",
      "description": "Structured sales battle card containing pitching points."
    }
  },
  "entrypoint": "client.py",
  "example": "example_usage.py"
}